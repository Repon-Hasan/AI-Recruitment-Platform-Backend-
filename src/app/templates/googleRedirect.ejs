<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <title>Continue with Google</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #6366f1;
            --primary-dark: #4f46e5;
            --text: #111827;
            --muted: #6b7280;
            --border: rgba(255, 255, 255, 0.25);
            --card: rgba(255, 255, 255, 0.88);
            --error: #dc2626;
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;

            font-family:
                Inter,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                Arial,
                sans-serif;

            color: var(--text);

            background:
                radial-gradient(
                    circle at 10% 20%,
                    rgba(99, 102, 241, 0.35),
                    transparent 30%
                ),
                radial-gradient(
                    circle at 90% 80%,
                    rgba(168, 85, 247, 0.3),
                    transparent 30%
                ),
                linear-gradient(
                    135deg,
                    #eef2ff 0%,
                    #f8fafc 50%,
                    #f5f3ff 100%
                );

            overflow: hidden;
        }

        /* Animated background shapes */

        .background {
            position: fixed;
            inset: 0;
            overflow: hidden;
            pointer-events: none;
            z-index: 0;
        }

        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(2px);
            opacity: 0.45;
            animation: float 8s ease-in-out infinite;
        }

        .orb-1 {
            width: 220px;
            height: 220px;
            background: #818cf8;
            top: -80px;
            left: -70px;
        }

        .orb-2 {
            width: 280px;
            height: 280px;
            background: #c084fc;
            right: -100px;
            bottom: -100px;
            animation-delay: -3s;
        }

        .orb-3 {
            width: 120px;
            height: 120px;
            background: #38bdf8;
            right: 20%;
            top: 15%;
            opacity: 0.2;
            animation-delay: -5s;
        }

        @keyframes float {
            0%,
            100% {
                transform: translateY(0) translateX(0);
            }

            50% {
                transform: translateY(-25px) translateX(15px);
            }
        }

        /* Main container */

        .container {
            position: relative;
            z-index: 1;

            width: min(92%, 430px);

            animation: cardEnter 0.7s ease forwards;
        }

        @keyframes cardEnter {
            from {
                opacity: 0;
                transform: translateY(25px) scale(0.97);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        /* Card */

        .card {
            padding: 42px 34px 34px;

            background: var(--card);

            border: 1px solid var(--border);

            border-radius: 28px;

            box-shadow:
                0 25px 60px rgba(15, 23, 42, 0.12),
                0 8px 25px rgba(15, 23, 42, 0.06);

            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);

            text-align: center;
        }

        /* Logo */

        .logo-wrapper {
            width: 72px;
            height: 72px;

            margin: 0 auto 24px;

            display: flex;
            align-items: center;
            justify-content: center;

            background: white;

            border-radius: 20px;

            box-shadow:
                0 10px 25px rgba(15, 23, 42, 0.1);

            animation: logoPulse 2.5s ease-in-out infinite;
        }

        .google-logo {
            width: 38px;
            height: 38px;
        }

        @keyframes logoPulse {
            0%,
            100% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.04);
            }
        }

        /* Typography */

        h1 {
            font-size: 26px;
            line-height: 1.25;
            font-weight: 700;

            letter-spacing: -0.5px;

            margin-bottom: 10px;
        }

        .subtitle {
            color: var(--muted);

            font-size: 15px;
            line-height: 1.6;

            max-width: 310px;

            margin: 0 auto 28px;
        }

        /* Loading area */

        .loading-container {
            display: flex;
            flex-direction: column;
            align-items: center;

            gap: 14px;

            padding: 18px 0 10px;
        }

        .spinner {
            width: 42px;
            height: 42px;

            border-radius: 50%;

            border: 4px solid #e5e7eb;
            border-top-color: var(--primary);

            animation: spin 0.9s linear infinite;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .loading-text {
            color: #4b5563;

            font-size: 14px;
            font-weight: 500;
        }

        /* Progress bar */

        .progress-wrapper {
            width: 100%;
            height: 5px;

            margin-top: 22px;

            background: #e5e7eb;

            border-radius: 999px;

            overflow: hidden;
        }

        .progress {
            height: 100%;
            width: 35%;

            border-radius: inherit;

            background:
                linear-gradient(
                    90deg,
                    #6366f1,
                    #8b5cf6,
                    #a855f7
                );

            animation: progress 1.8s ease-in-out infinite;
        }

        @keyframes progress {
            0% {
                transform: translateX(-120%);
            }

            100% {
                transform: translateX(320%);
            }
        }

        /* Security text */

        .security {
            display: flex;
            align-items: center;
            justify-content: center;

            gap: 7px;

            margin-top: 26px;

            color: #6b7280;

            font-size: 12px;
        }

        .lock {
            width: 14px;
            height: 14px;
        }

        /* Error state */

        .error-container {
            display: none;

            animation: errorEnter 0.4s ease forwards;
        }

        @keyframes errorEnter {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .error-icon {
            width: 58px;
            height: 58px;

            display: flex;
            align-items: center;
            justify-content: center;

            margin: 0 auto 18px;

            border-radius: 50%;

            background: #fee2e2;

            color: var(--error);

            font-size: 27px;
        }

        .error-title {
            color: #991b1b;

            font-size: 20px;

            margin-bottom: 8px;
        }

        .error-message {
            color: var(--muted);

            font-size: 14px;

            line-height: 1.6;

            margin-bottom: 20px;

            word-break: break-word;
        }

        .retry-button {
            width: 100%;

            border: none;

            padding: 13px 20px;

            border-radius: 12px;

            background:
                linear-gradient(
                    135deg,
                    var(--primary),
                    var(--primary-dark)
                );

            color: white;

            font-size: 14px;
            font-weight: 600;

            cursor: pointer;

            transition:
                transform 0.2s ease,
                box-shadow 0.2s ease;
        }

        .retry-button:hover {
            transform: translateY(-2px);

            box-shadow:
                0 10px 20px rgba(79, 70, 229, 0.25);
        }

        .retry-button:active {
            transform: translateY(0);
        }

        /* Footer */

        .footer {
            text-align: center;

            margin-top: 18px;

            color: #94a3b8;

            font-size: 12px;
        }

        /* Mobile */

        @media (max-width: 480px) {
            .card {
                padding: 34px 24px 28px;

                border-radius: 24px;
            }

            h1 {
                font-size: 23px;
            }

            .subtitle {
                font-size: 14px;
            }

            .logo-wrapper {
                width: 64px;
                height: 64px;
            }

            .google-logo {
                width: 34px;
                height: 34px;
            }
        }

        /* Reduced motion accessibility */

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
            }
        }
    </style>
</head>

<body>

    <!-- Animated background -->
    <div class="background">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>
    </div>

    <main class="container">

        <section class="card">

            <!-- Loading State -->
            <div id="loadingState">

                <!-- Google Logo -->
                <div class="logo-wrapper">
                    <svg
                        class="google-logo"
                        viewBox="0 0 48 48"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            fill="#FFC107"
                            d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.2 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.2-.1-2.3-.4-3.5z"
                        />

                        <path
                            fill="#FF3D00"
                            d="M6.3 14.7l6.6 4.8C14.7 16 18.9 12 24 12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.2 6.1 29.3 4 24 4c-7.7 0-14.3 4.3-17.7 10.7z"
                        />

                        <path
                            fill="#4CAF50"
                            d="M24 44c5.2 0 10-2 13.6-5.2l-6.3-5.2C29.7 35.1 27 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.6 5.1C9.5 39.7 16.2 44 24 44z"
                        />

                        <path
                            fill="#1976D2"
                            d="M43.6 20.5H42V20H24v8h11.3c-1.1 3.3-4.1 5.6-7.3 6.6l6.3 5.2C38 36.6 44 31.1 44 24c0-1.2-.1-2.3-.4-3.5z"
                        />
                    </svg>
                </div>

                <h1>
                    Continue with Google
                </h1>

                <p class="subtitle">
                    You're being securely redirected to Google
                    to continue signing in to your account.
                </p>

                <div class="loading-container">

                    <div class="spinner"></div>

                    <span
                        class="loading-text"
                        id="loadingText"
                    >
                        Connecting to Google...
                    </span>

                </div>

                <div class="progress-wrapper">
                    <div class="progress"></div>
                </div>

                <div class="security">

                    <svg
                        class="lock"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <rect
                            x="3"
                            y="11"
                            width="18"
                            height="10"
                            rx="2"
                        ></rect>

                        <path
                            d="M7 11V7a5 5 0 0110 0v4"
                        ></path>
                    </svg>

                    <span>
                        Secure authentication powered by Google
                    </span>

                </div>

            </div>

            <!-- Error State -->
            <div
                id="errorState"
                class="error-container"
            >

                <div class="error-icon">
                    !
                </div>

                <h2 class="error-title">
                    Something went wrong
                </h2>

                <p
                    id="errorMessage"
                    class="error-message"
                >
                    We couldn't connect to Google.
                    Please try again.
                </p>

                <button
                    id="retryButton"
                    class="retry-button"
                    type="button"
                >
                    Try Again
                </button>

            </div>

        </section>

        <div class="footer">
            © <span id="year"></span> AI Recruitment Platform
        </div>

    </main>

    <script>
        (() => {

            const loadingState =
                document.getElementById("loadingState");

            const errorState =
                document.getElementById("errorState");

            const errorMessage =
                document.getElementById("errorMessage");

            const retryButton =
                document.getElementById("retryButton");

            const loadingText =
                document.getElementById("loadingText");

            const year =
                document.getElementById("year");

            year.textContent =
                new Date().getFullYear();


            /**
             * Start Google OAuth
             */
            async function startGoogleLogin() {

                try {

                    loadingState.style.display = "block";
                    errorState.style.display = "none";

                    loadingText.textContent =
                        "Connecting to Google...";


                    const response = await fetch(
                        "<%= betterAuthUrl %>/api/auth/sign-in/social",
                        {
                            method: "POST",

                            headers: {
                                "Content-Type":
                                    "application/json"
                            },

                            credentials: "include",

                            body: JSON.stringify({
                                provider: "google",

                                callbackURL:
                                    "<%= callbackURL %>"
                            })
                        }
                    );


                    if (!response.ok) {

                        throw new Error(
                            `Authentication request failed (${response.status})`
                        );

                    }


                    const data =
                        await response.json();


                    if (data.url) {

                        loadingText.textContent =
                            "Redirecting to Google...";

                        /*
                         * Small delay gives the user
                         * feedback before redirecting.
                         */
                        setTimeout(() => {

                            window.location.href =
                                data.url;

                        }, 300);

                        return;

                    }


                    throw new Error(
                        data.message ||
                        "Google authentication URL was not returned."
                    );


                } catch (error) {

                    console.error(
                        "Google OAuth Error:",
                        error
                    );


                    loadingState.style.display =
                        "none";

                    errorState.style.display =
                        "block";


                    errorMessage.textContent =
                        error?.message ||
                        "Unable to connect to Google. Please try again.";

                }

            }


            /**
             * Retry authentication
             */
            retryButton.addEventListener(
                "click",
                () => {

                    startGoogleLogin();

                }
            );


            /**
             * Start automatically
             */
            startGoogleLogin();

        })();
    </script>

</body>
</html>