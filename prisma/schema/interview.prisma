model InterviewSession {
  id                String   @id @default(uuid())
  candidateProfileId String
  jobId             String

  experienceLevel   String
  interviewType     String

  currentQuestion   Int      @default(0)
  status            String   @default("IN_PROGRESS")

  overallScore      Float?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  candidateProfile  CandidateProfile @relation(fields: [candidateProfileId], references: [id],onDelete: Cascade )

  job Job @relation(fields: [jobId],references: [id],onDelete: Cascade)

  answers           InterviewAnswer[]

  @@index([candidateProfileId])
  @@index([jobId])
  @@index([status])
  @@index([createdAt])
}

model InterviewAnswer {
  id             String   @id @default(uuid())

  sessionId      String
  question       String
  candidateAnswer String

  technicalAccuracy Float?
  communication     Float?
  confidence        Float?
  completeness      Float?
  overallScore      Float?

  feedback       String?

  createdAt      DateTime @default(now())

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Interview {
  id              String          @id @default(uuid())

  jobApplicationId String
  scheduledById    String

  scheduledAt     DateTime
  durationMinutes Int             @default(30)

  type            InterviewType   @default(VIDEO)
  status          InterviewStatus @default(SCHEDULED)

  meetingUrl      String?
  title           String?
  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  jobApplication JobApplication @relation(fields: [jobApplicationId],references: [id],onDelete: Cascade)

  scheduledBy User @relation(fields: [scheduledById],references: [id],onDelete: Cascade)

  @@index([jobApplicationId])
  @@index([scheduledById])
  @@index([scheduledAt])
  @@index([status])
}

model ApplicationAssistant {
  id                  String   @id @default(uuid())

  candidateProfileId  String
  jobId               String
  resumeId             String?

  matchScore           Int
  recommendation       String

  missingSkills        Json
  suggestions          Json
  applicationTips      Json

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id])

  job Job @relation(fields: [jobId], references: [id])

  @@unique([candidateProfileId, jobId])
}
