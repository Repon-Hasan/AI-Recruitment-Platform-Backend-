model Company {
  id          String   @id @default(uuid())
  name        String
  description String?
  website     String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobs Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id             String  @id @default(uuid())
  companyId      String
  title          String
  description    String
  location       String?
  employmentType String?

  requiredSkills JobSkill[]
  matches        JobMatch[]

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  skillGapAnalyses SkillGapAnalysis[]
  jobApplications  JobApplication[]

  embedding Unsupported("vector(2048)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  interviewSessions InterviewSession[]
}

model JobSkill {
  id       String @id @default(uuid())
  jobId    String
  name     String
  priority String @default("medium")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model JobMatch {
  id              String   @id @default(uuid())

  candidateId     String
  jobId           String

  overallScore    Float
  semanticScore   Float
  skillsScore     Float
  experienceScore Float
  educationScore  Float
  keywordScore    Float

  missingSkills   Json
  matchedSkills   Json

  recommendation  String

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([candidateId, jobId])
  @@index([candidateId])
  @@index([jobId])
}

model SkillGapAnalysis {
  id                   String @id @default(uuid())
  candidateId          String
  jobId                String
  skillMatchPercentage Int

  matchedSkills  Json
  missingSkills  Json
  highPriority   Json
  mediumPriority Json
  lowPriority    Json
  learningPath   Json

  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([candidateId, jobId])
  @@index([candidateId])
  @@index([jobId])
  jobApplications JobApplication[]
}

model JobApplication {
  id                 String @id @default(uuid())
  candidateProfileId String
  jobId              String

  status             ApplicationStatus @default(APPLIED)

  candidateProfile   CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  job                Job @relation( fields: [jobId], references: [id], onDelete: Cascade)
   

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([candidateProfileId, jobId])
  @@index([candidateProfileId])
  @@index([jobId])
  @@index([status])
  skillGapAnalyses SkillGapAnalysis[]
  applicationStatusHistories ApplicationStatusHistory[]
}

model ApplicationStatusHistory {
  id            String @id @default(uuid())

  applicationId String
  oldStatus     ApplicationStatus?
  newStatus     ApplicationStatus

  changedById   String
  changedAt     DateTime @default(now())

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}