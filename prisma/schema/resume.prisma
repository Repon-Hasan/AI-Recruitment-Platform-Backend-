model Resume {
  id          String           @id @default(uuid())
  candidateId String
  fileName    String
  fileUrl     String
  publicId    String
  fileType    String
  fileSize    Int?
  rawText     String?
  parsedData  Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  summary     ResumeSummary?
  analysis    ResumeAnalysis?
  chunks      ResumeChunk[]
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  embedding Unsupported("vector(2048)")?
  @@map("resumes")
}

model ResumeAnalysis {
  id                  String   @id @default(uuid())
  resumeId            String   @unique
  overallScore        Int
  skillsScore         Int
  experienceScore     Int
  educationScore      Int
  projectsScore       Int
  certificationsScore Int
  strengths           Json
  weaknesses          Json
  suggestions         Json
  missingSkills       Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  resume              Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("resume_analysis")
}

model ResumeChunk {
  id        String   @id @default(uuid())
  resumeId  String
  chunkText String
  chunkIndex Int

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  embedding Unsupported("vector(2048)")?

  createdAt DateTime @default(now())

  @@index([resumeId])
  @@map("resume_chunks")
}
